{
  "name": "linguaflow-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:wasm": "node scripts/copy-ort-assets.mjs",
    "export:local-content": "node scripts/export-local-content.mjs",
    "prepare:public": "node scripts/prepare-public.mjs",
    "sync:public": "node scripts/sync-public.mjs",
    "predev": "npm run prepare:wasm",
    "dev": "vite --host 127.0.0.1 --port 3012",
    "prebuild": "npm run prepare:wasm",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3012",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/literata": "^5.2.6",
    "@huggingface/transformers": "^4.3.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
